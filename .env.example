# ═══════════════════════════════════════════════════════════════════════════
# 🔐 MR. X STEROID — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env or .env.local to Git.
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE CONFIGURATION (Required)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Anonymous Key (Public — safe to expose in client code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (SECRET — backend/server only!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase DB direct connection (for Prisma/migrations only — never expose)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE PAYMENT GATEWAY (Global / USD / EUR)
# Get from: https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────────────────────────────────────

# Stripe Publishable Key (Public — safe for client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Secret Key (SECRET — server only!)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Signing Secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs
STRIPE_PRICE_ID_PDF=price_your_pdf_price_id_here
STRIPE_PRICE_ID_PAPERBACK=price_your_paperback_price_id_here

# ─────────────────────────────────────────────────────────────────────────────
# PAYMOB PAYMENT GATEWAY (Egypt / EGP)
# Get from: https://accept.paymob.com/portal2/en/settings
# ─────────────────────────────────────────────────────────────────────────────

PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here
PAYMOB_LINK_PDF=https://accept.paymob.com/standalone/?ref=your_pdf_link_ref
PAYMOB_LINK_PAPERBACK=https://accept.paymob.com/standalone/?ref=your_paperback_link_ref

# ─────────────────────────────────────────────────────────────────────────────
# SPACEREMIT PAYMENT GATEWAY
# Get from: https://spaceremit.com/dashboard
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SPACEREMIT_PUBLIC_KEY=pk_your_spaceremit_public_key_here
SPACEREMIT_SECRET_KEY=your_spaceremit_secret_key_here
SPACEREMIT_WEBHOOK_SECRET=your_spaceremit_webhook_secret_here
SPACEREMIT_API_KEY=your_spaceremit_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH REDIS (Rate Limiting & Caching)
# Get from: https://console.upstash.com/
# ─────────────────────────────────────────────────────────────────────────────

UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ─────────────────────────────────────────────────────────────────────────────
# SMTP / EMAIL (Gmail App Password)
# ─────────────────────────────────────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password_here
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password_here
CONTACT_DESTINATION_EMAIL=your_contact_email@example.com

# ─────────────────────────────────────────────────────────────────────────────
# SITE & APP CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://mrxsteroid.vercel.app
VITE_ENCRYPTION_KEY=your_32_character_random_encryption_key

# Payment redirect URLs
NEXT_PUBLIC_PAYMENT_SUCCESS_URL=https://mrxsteroid.vercel.app/success
NEXT_PUBLIC_PAYMENT_CANCEL_URL=https://mrxsteroid.vercel.app/cancel
NEXT_PUBLIC_PAYMENT_CALLBACK_URL=https://mrxsteroid.vercel.app/api/payments/callback

# ─────────────────────────────────────────────────────────────────────────────
# AI INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────

# Google AI Studio / Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible API base URL
# Jan AI (local): http://localhost:1337/v1
# Ollama (local): http://localhost:11434/v1
# Google AI Studio proxy: https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=http://localhost:1337/v1
OPENAI_API_KEY=your_openai_or_local_llm_api_key_here

# Jan AI Local Server
JAN_API_BASE_URL=http://localhost:1337/v1
JAN_API_KEY=jan-local-api-key

# Ollama Local Server (alternative to Jan)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Anthropic Claude (for OpenCode integration)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# VERCEL DEPLOYMENT
# Set these in: Vercel Dashboard > Project Settings > Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Vercel sets this automatically in production deployments
VERCEL_URL=mrxsteroid.vercel.app
VERCEL_ENV=development

# ═══════════════════════════════════════════════════════════════════════════
# 📋 REQUIRED FOR PRODUCTION (must set in Vercel Dashboard)
# ═══════════════════════════════════════════════════════════════════════════
#
#  Core (always required):
#   - NEXT_PUBLIC_SUPABASE_URL
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - SUPABASE_SERVICE_ROLE_KEY        ← SECRET
#
#  Payments:
#   - STRIPE_SECRET_KEY                ← SECRET
#   - STRIPE_WEBHOOK_SECRET            ← SECRET
#   - STRIPE_PRICE_ID_PDF
#   - STRIPE_PRICE_ID_PAPERBACK
#   - PAYMOB_HMAC_SECRET               ← SECRET
#   - SPACEREMIT_SECRET_KEY            ← SECRET
#
#  Infrastructure:
#   - UPSTASH_REDIS_REST_URL
#   - UPSTASH_REDIS_REST_TOKEN         ← SECRET
#   - SMTP_PASS / GMAIL_APP_PASSWORD   ← SECRET
#
# ═══════════════════════════════════════════════════════════════════════════
