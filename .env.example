# ─────────────────────────────────────────────────────────────────────────────
# SPACEREMIT PAYMENT GATEWAY CONFIGURATION
# Get these from: https://spaceremit.com/dashboard
# ─────────────────────────────────────────────────────────────────────────────

# SpaceRemit Public Key (starts with pk_ for live or sb_ for sandbox)
VITE_SPACEREMIT_PUBLIC_KEY=pkO6RUYNRPVWTC7VDPNOFLMAUTJ0GNN42YEALB26SSOQR46EX20A

# SpaceRemit Secret Key (SECRET - For backend only!)
# ⚠️ IMPORTANT: Add this to Vercel Environment Variables!
# Live Secret Key: sk2ESRSUHSEXGXOHVQHH2EQGB2IK6RTAB64GUGN0Q53BMPMANBWB
SPACEREMIT_SECRET_KEY=sk2ESRSUHSEXGXOHVQHH2EQGB2IK6RTAB64GUGN0Q53BMPMANBWB

# SpaceRemit Webhook Secret (Same as Secret Key for signature verification)
SPACEREMIT_WEBHOOK_SECRET=sk2ESRSUHSEXGXOHVQHH2EQGB2IK6RTAB64GUGN0Q53BMPMANBWB
SPACEREMIT_API_KEY=your_api_key

# ─────────────────────────────────────────────────────────────────────────────
# SMTP CONFIGURATION (Gmail)
# ─────────────────────────────────────────────────────────────────────────────

# Gmail SMTP
SMTP_USER=foryoutalk@gmail.com
SMTP_PASS=your_app_password_here
GMAIL_APP_PASSWORD=your_app_password_here

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE PAYMENT GATEWAY CONFIGURATION
# Get these from: https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────────────────────────────────────

# Stripe Secret Key (SECRET - For backend only!)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (from Stripe Dashboard > Webhooks > Signing Secret)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (from Stripe Dashboard > Products > Prices)
STRIPE_PRICE_ID_PDF=price_your_pdf_price_id_here
STRIPE_PRICE_ID_PAPERBACK=price_your_paperback_price_id_here

# ─────────────────────────────────────────────────────────────────────────────
# PAYMOB PAYMENT GATEWAY CONFIGURATION (Egypt - EGP)
# Get these from: https://accept.paymob.com/portal2/en/settings
# ─────────────────────────────────────────────────────────────────────────────

# Paymob HMAC Secret (from Paymob Dashboard > Settings > Account Info)
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here

# Paymob Standalone Payment Links (from Paymob Dashboard > Payment Links)
PAYMOB_LINK_PDF=https://accept.paymob.com/standalone/?ref=your_pdf_link_ref
PAYMOB_LINK_PAPERBACK=https://accept.paymobsolutions.com/standalone?ref=your_paperback_link_ref

# ─────────────────────────────────────────────────────────────────────────────
# CALLBACK URLs (Optional - Defaults provided)
# ─────────────────────────────────────────────────────────────────────────────

# Payment callback URL (Gateways will redirect/post here after payment)
VITE_SPACEREMIT_CALLBACK_URL=https://mrxsteroid.vercel.app/api/payments/callback

# Success redirect URL
VITE_PAYMENT_SUCCESS_URL=https://mrxsteroid.vercel.app/success

# Cancel redirect URL
VITE_PAYMENT_CANCEL_URL=https://mrxsteroid.vercel.app/cancel

# ─────────────────────────────────────────────────────────────────────────────
# SITE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Site URL
VITE_SITE_URL=https://mrxsteroid.vercel.app

# Encryption key for sensitive data (generate a random 32-char string)
VITE_ENCRYPTION_KEY=your_32_character_encryption_key_here

# ─────────────────────────────────────────────────────────────────────────────
# AI CONFIGURATION (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (Optional - for AI features)
VITE_OPENAI_API_KEY=

# Google Gemini API Key (Optional - for AI features)
VITE_GEMINI_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# 🚀 VERCEL DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════════════════
# 
# When deploying to Vercel, add these environment variables in:
# Project Settings > Environment Variables
#
# Required for production:
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY (Backend only - SECRET!)
# - VITE_SPACEREMIT_PUBLIC_KEY
# - SPACEREMIT_SECRET_KEY (Backend only - SECRET!)
# - VITE_ENCRYPTION_KEY
#
# For Stripe (US/EU/Global payments):
# - STRIPE_SECRET_KEY (Backend only - SECRET!)
# - STRIPE_WEBHOOK_SECRET (Backend only - SECRET!)
# - STRIPE_PRICE_ID_PDF
# - STRIPE_PRICE_ID_PAPERBACK
#
# For Paymob (Egypt EGP payments):
# - PAYMOB_HMAC_SECRET (Backend only - SECRET!)
# - PAYMOB_LINK_PDF
# - PAYMOB_LINK_PAPERBACK
#
# ═══════════════════════════════════════════════════════════════════════════

