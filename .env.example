# ═══════════════════════════════════════════════════════════════════════════
# MR. X STEROID - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# COPY THIS FILE TO .env (Local) or Add to Vercel Environment Variables (Production)
# ⚠️ NEVER COMMIT REAL KEYS TO GIT
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
#                         SUPABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Vercel Environment Variables)
# SUPABASE_SERVICE_ROLE_KEY=

# ═══════════════════════════════════════════════════════════════════════════
#                         SPACEREMIT PAYMENT GATEWAY
# ═══════════════════════════════════════════════════════════════════════════

# Frontend (Public Keys) - Safe to expose
VITE_SPACEREMIT_PUBLIC_KEY=
VITE_SPACEREMIT_CALLBACK_URL=https://mrxsteroid.vercel.app/api/payments/callback
VITE_PAYMENT_SUCCESS_URL=https://mrxsteroid.vercel.app/payment-success
VITE_PAYMENT_CANCEL_URL=https://mrxsteroid.vercel.app/payment-cancel

# Test Keys (for development)
VITE_SPACEREMIT_TEST_PUBLIC_KEY=

# ═══════════════════════════════════════════════════════════════════════════
#                    ⚠️ SERVER-SIDE ONLY (Vercel Env Vars)
# ═══════════════════════════════════════════════════════════════════════════
# CRITICAL: These must be set in Vercel Dashboard > Settings > Environment Variables
# NEVER add these to frontend code or commit to Git

# SPACEREMIT_SECRET_KEY=
# SPACEREMIT_WEBHOOK_SECRET=
# SPACEREMIT_TEST_SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════════════
#                         SECURITY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Encryption Key (32 characters minimum for AES-256)
# Generate with: openssl rand -hex 32
VITE_ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════════════════════════
#                         AI FEATURES (Optional)
# ═══════════════════════════════════════════════════════════════════════════

# Gemini API Key (Google AI Studio)
VITE_GEMINI_API_KEY=

# OpenAI API Key (Optional Fallback)
VITE_OPENAI_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
#                         LEGACY/DEPRECATED
# ═══════════════════════════════════════════════════════════════════════════

# Stripe (Not used - SpaceRemit is the primary gateway)
VITE_STRIPE_PUBLIC_KEY=