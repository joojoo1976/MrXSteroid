# Firebase/Supabase Configuration
# احصل على هذه القيم من لوحة تحكم Supabase الخاصة بك
# Get these values from your Supabase Dashboard

# Supabase URL - default URL is provided, replace with your own if needed
VITE_SUPABASE_URL=https://alghvtpkpspnqupbvodu.supabase.co

# Supabase Anonymous Key - REQUIRED for authentication to work
# يجب إضافة مفتاح Supabase الخاص بك هنا
# You MUST add your Supabase anon key here for login to work
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# كيفية الحصول على المفتاح:
# How to get your key:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project (or create a new one)
# 3. Go to Settings > API
# 4. Copy the "anon public" key
# 5. Paste it above replacing "your-supabase-anon-key-here"
# Stripe Configuration
# احصل على مفتاح Stripe القابل للنشر هنا: https://dashboard.stripe.com/test/apikeys
# Get your Stripe Publishable Key here: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLIC_KEY=your-stripe-public-key-here
