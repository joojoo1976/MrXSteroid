# EMAIL DELIVERY (SendGrid API â€” Primary / Recommended)
# Get from: https://app.sendgrid.com/api-keys
# Free tier: 100 emails/day, 3000 emails/month
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM=MrXSteroid.com <support@mrxsteroid.com>
# Where inbound contact-form messages are delivered (the owner's inbox):
CONTACT_DESTINATION_EMAIL=foryoutalk@gmail.com
# Optional CC so the branded support address also receives a copy:
CONTACT_CC_EMAIL=support@mrxsteroid.com

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# SMTP / EMAIL (Gmail App Password â€” Fallback if SendGrid is unavailable)
# Also used by /api/auth/welcome to send the branded signup confirmation.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=foryoutalk@gmail.com
SMTP_PASS=your_16_char_gmail_app_password_here
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password_here
SMTP_SENDER_NAME=MrXSteroid.com

