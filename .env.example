# ═══════════════════════════════════════════════════════════════════════════
# 🔐 MR. X STEROID - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE CONFIGURATION (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://alghvtpkpspnqupbvodu.supabase.co

# Supabase Anonymous Key (Public - Safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFsZ2h2dHBrcHNwbnF1cGJ2b2R1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjU4NDgyMTYsImV4cCI6MjA4MTQyNDIxNn0.4en9cYMCkIwxd1pWxehb9-lP77cHgh5FhZnrBRg-yaw

# Supabase Service Role Key (SECRET - For backend only! Never expose to client!)
# Used in Vercel serverless functions for admin operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─────────────────────────────────────────────────────────────────────────────
# SPACEREMIT PAYMENT GATEWAY CONFIGURATION
# Get these from: https://spaceremit.com/dashboard
# ─────────────────────────────────────────────────────────────────────────────

# SpaceRemit Public Key (starts with pk_ for live or sb_ for sandbox)
VITE_SPACEREMIT_PUBLIC_KEY=pkO6RUYNRPVWTC7VDPNOFLMAUTJ0GNN42YEALB26SSOQR46EX20A

# SpaceRemit Secret Key (SECRET - For backend only!)
SPACEREMIT_SECRET_KEY=your_spaceremit_secret_key_here

# SpaceRemit Webhook Secret (Optional - for signature verification)
SPACEREMIT_WEBHOOK_SECRET=your_webhook_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# CALLBACK URLs (Optional - Defaults provided)
# ─────────────────────────────────────────────────────────────────────────────

# Payment callback URL (SpaceRemit will redirect here after payment)
VITE_SPACEREMIT_CALLBACK_URL=https://mrxsteroid.vercel.app/api/payments/callback

# Success redirect URL
VITE_PAYMENT_SUCCESS_URL=https://mrxsteroid.vercel.app/success

# Cancel redirect URL
VITE_PAYMENT_CANCEL_URL=https://mrxsteroid.vercel.app/cancel

# ─────────────────────────────────────────────────────────────────────────────
# SITE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Site URL
VITE_SITE_URL=https://mrxsteroid.vercel.app

# Encryption key for sensitive data (generate a random 32-char string)
VITE_ENCRYPTION_KEY=your_32_character_encryption_key_here

# ─────────────────────────────────────────────────────────────────────────────
# AI CONFIGURATION (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (Optional - for AI features)
VITE_OPENAI_API_KEY=

# Google Gemini API Key (Optional - for AI features)
VITE_GEMINI_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# 🚀 VERCEL DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════════════════
# 
# When deploying to Vercel, add these environment variables in:
# Project Settings > Environment Variables
#
# Required for production:
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY (Backend only - SECRET!)
# - VITE_SPACEREMIT_PUBLIC_KEY
# - SPACEREMIT_SECRET_KEY (Backend only - SECRET!)
# - VITE_ENCRYPTION_KEY
#
# ═══════════════════════════════════════════════════════════════════════════
