# MR. X - Environment Configuration
# COPY THIS FILE TO .env (Local) or Add to Vercel Environment Variables (Production)
# NEVER COMMIT REAL KEYS TO GIT

# --- Core API (Required for AI Features) ---
# Gemini API Key (Google AI Studio)
VITE_GEMINI_API_KEY=

# OpenAI API Key (Optional Fallback)
VITE_OPENAI_API_KEY=

# --- Database & Auth (Required) ---
# Supabase URL (Project Settings -> API)
VITE_SUPABASE_URL=

# Supabase Anon Key (Project Settings -> API)
# SAFETY NOTE: This is safe to expose on client-side ONLY if RLS is enabled.
VITE_SUPABASE_ANON_KEY=

# --- Security (Required) ---
# Key for client-side local storage encryption (Any random strong string)
# EXAMPLE: mrx-prod-enc-key-998877
VITE_ENCRYPTION_KEY=

# --- Payments (Stripe) ---
# Stripe Publishable Key (Developers -> API Keys)
# SAFETY NOTE: use pk_test_... for Development, pk_live_... for Production
VITE_STRIPE_PUBLIC_KEY=

# CRITICAL: NEVER ADD STRIPE_SECRET_KEY HERE.
# Secret keys must be handled on the backend (Supabase Edge Functions).
