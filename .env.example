# MR. X - Environment Configuration
# COPY THIS FILE TO .env (Local) or Add to Vercel Environment Variables (Production)
# NEVER COMMIT REAL KEYS TO GIT

# --- Core API (Required for AI Features) ---
# Gemini API Key (Google AI Studio)
VITE_GEMINI_API_KEY=

# OpenAI API Key (Optional Fallback)
VITE_OPENAI_API_KEY=

VITE_STRIPE_PUBLIC_KEY=

# CRITICAL: NEVER ADD STRIPE_SECRET_KEY HERE.
# Secret keys must be handled on the backend (Supabase Edge Functions).
