# ============================================================
# MrXSteroid — .dockerignore
# Excludes everything not needed in the Docker build context
# ============================================================

# ------ Git -------------------------------------------------
.git
.gitignore
.gitattributes

# ------ Dependencies (will be installed inside image) -------
node_modules

# ------ Build Cache & Outputs (rebuilt inside image) --------
.next
out
dist
build
*.tsbuildinfo

# ------ Environment files (mount as secrets at runtime) -----
.env
.env.local
.env.*.local
.env.development
.env.production

# ------ Docker files (no recursion needed) ------------------
Dockerfile*
docker-compose*
compose*.yaml
compose*.yml
.dockerignore

# ------ AI Agent & IDE caches --------------------------------
.agent
.agents
.cursor
.qwen
.roo
.vscode
.idea

# ------ CI / Infra ------------------------------------------
.github
.vercel
.vercelignore

# ------ Python artifacts ------------------------------------
.venv
venv
__pycache__
*.pyc
*.pyo

# ------ Docker layer blob cache (from docker save) ----------
blobs
manifests

# ------ Logs & Debug ----------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
.dev-err.log
.dev-out.log
dev.log

# ------ OS Files --------------------------------------------
.DS_Store
Thumbs.db
*.tmp

# ------ Test & Coverage -------------------------------------
coverage
htmlcov
*.test.*
*.spec.*
vitest.config.*
vitest.setup.*

# ------ Docs ------------------------------------------------
*.md
LICENSE

# ------ Large binary/archive files -------------------------
*.zip
*.gz
*.tar
*.7z
*.rar
