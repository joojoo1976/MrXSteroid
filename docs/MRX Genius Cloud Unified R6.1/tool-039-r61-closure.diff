+          >
+            {t.genius_compact}
+          </button>
+          <button
+            type="button"
+            onClick={() => setCompact(false)}
+            aria-pressed={!compact}
+            className={`rounded px-3 py-1 text-xs font-bold ${compact ? 'bg-zinc-800 text-zinc-200' : 'bg-lime-500 text-slate-950'}`}
+          >
+            {t.genius_full}
+          </button>
+        </div>
+      </div>
+
+      {visibleBoxes.map((box) => {
